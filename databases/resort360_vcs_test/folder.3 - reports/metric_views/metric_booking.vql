CREATE OR REPLACE METRIC VIEW metric_booking
    FOLDER = '/3 - reports'
    SOURCES (
        bv_resorts AS bv_resorts,
        bv_booking_type AS bv_booking_type,
        bv_booking AS bv_booking    
    )
    ASSOCIATIONS (
        bv_booking_type bv_booking a_bv_booking_type_resort360_bv_booking,
        bv_resorts bv_booking a_bv_resorts_resort360_bv_booking    
    )
    DIMENSIONS (
        bv_booking(
            booking_id AS bv_booking.booking_id,
            resort_id AS bv_booking.resort_id,
            booking_date AS bv_booking.booking_date,
            booking_type_id AS bv_booking.booking_type_id,
            tour_operator_id AS bv_booking.tour_operator_id,
            tour_operator_contract_id AS bv_booking.tour_operator_contract_id,
            customer_id AS bv_booking.customer_id,
            arrival_date AS bv_booking.arrival_date,
            arrival_time AS bv_booking.arrival_time,
            no_of_pax AS bv_booking.no_of_pax,
            reservation_start_date AS bv_booking.reservation_start_date,
            reservation_end_date AS bv_booking.reservation_end_date,
            no_of_days AS bv_booking.no_of_days,
            is_checked_in AS bv_booking.is_checked_in,
            room_master_id AS bv_booking.room_master_id,
            departure_date AS bv_booking.departure_date,
            departure_time AS bv_booking.departure_time,
            is_checked_out AS bv_booking.is_checked_out,
            customer_enquiry_id AS bv_booking.customer_enquiry_id,
            "Booking_Status" AS bv_booking."Booking_Status",
            createddate AS bv_booking.createddate,
            "BookingModifiedDate" AS bv_booking."ModifiedDate",
            "BookingModifiedBy" AS bv_booking."ModifiedBy",
            "Currency_ID" AS bv_booking."Currency_ID",
            "Special_Requests" AS bv_booking."Special_Requests",
            "Cancellation_Reason" AS bv_booking."Cancellation_Reason",
            "Cancelled_By" AS bv_booking."Cancelled_By",
            "Cancelled_Date" AS bv_booking."Cancelled_Date"
        ),
        bv_booking_type(
            booking_type_description AS bv_booking_type.booking_type_description
        ),
        bv_resorts(
            resort_name AS bv_resorts.resort_name,
            resort_type AS bv_resorts.resort_type,
            state_id AS bv_resorts.state_id,
            address AS bv_resorts.address,
            city AS bv_resorts.city,
            phone AS bv_resorts.phone,
            email AS bv_resorts.email,
            star_rating AS bv_resorts.star_rating,
            description AS bv_resorts.description,
            amenities AS bv_resorts.amenities,
            check_in_time AS bv_resorts.check_in_time,
            check_out_time AS bv_resorts.check_out_time,
            default_currency_id AS bv_resorts.default_currency_id,
            timezone AS bv_resorts.timezone,
            is_active AS bv_resorts.is_active,
            created_date AS bv_resorts.created_date,
            modifieddate AS bv_resorts.modifieddate,
            modifiedby AS bv_resorts.modifiedby
        )    
    )
    METRICS (
        total_amount AS sum(bv_booking.final_amount),
        "Revenue Quality Score" AS (((sum(bv_booking.final_amount)-sum(bv_booking."Tax_Amount"))-sum((bv_booking.amount_before_discount-bv_booking.final_amount)))/nullif(sum((bv_booking.no_of_pax*bv_booking.no_of_days)), 0)),
        "Weighted Customer Value Index" AS ((sum(bv_booking.final_amount)*avg(bv_booking.no_of_days))/nullif(count(DISTINCT bv_booking.customer_id), 0)),
        "Occupancy Revenue Score" AS (sum(bv_booking.final_amount)-sum((bv_booking.amount_before_discount-bv_booking.final_amount)))    
    )
;

ALTER VIEW metric_booking
 LAYOUT (bv_resorts = [645, 192, 40, 80], bv_booking_type = [580, 38, 40, 80], bv_booking = [208, 82, 40, 80]);

