CREATE OR REPLACE VIEW dp_booking_demand FOLDER = '/4 - data products' DESCRIPTION = 'The dp_booking_demand view provides a detailed overview of booking-related data for resorts. It includes fields such as the resort name, total bookings, average stay duration, total booking revenue, confirmed and denied booking counts, booking confirmation rates, denied demand rates, and demand status. These fields collectively offer insights into the performance and demand trends of resorts, allowing for the identification of key metrics related to bookings, revenue generation, and customer demand patterns. The information is structured to capture both quantitative measures like revenue and booking counts, as well as qualitative trends such as demand status, making it a well-rounded dataset for understanding booking dynamics. This view could be used to analyze booking trends, assess the performance of resorts, measure customer demand, and track revenue generation. It would be valuable in identifying patterns in bookings, evaluating market trends, improving operational efficiency, and making data-driven decisions about pricing strategies or resource allocation for resorts.' 
    TAGS ("KPI", booking, mcp, resort, sales) (
    "Resort Name" (description = 'Represents the name of the resort, helping to identify and distinguish various accommodations.'),
    "Total bookings" (description = 'Indicates the total number of bookings recorded for a specific resort or room category.'),
    "Avg length of stay" (description = 'Represents the average duration of stay per booking, measured in days.'),
    "Total booking revenue" (description = 'Indicates the total revenue generated from bookings.'),
    "Confirmed booking count" (description = 'Represents the total number of bookings that have been successfully confirmed.'),
    "Denied booking count" (description = 'Indicates the total number of booking requests that were denied.'),
    "Booking confirmation rate" (description = 'Represents the percentage of booking requests that were successfully confirmed.'),
    "Demand status" (description = 'Indicates the current demand status for bookings, reflecting market trends or occupancy levels.')
 )
 AS SELECT bds.resort_name AS "Resort Name", bds.total_bookings AS "Total bookings", round(bds.avg_length_of_stay, 2) AS "Avg length of stay", round(bds.total_booking_revenue, 2) AS "Total booking revenue", coalesce(cbs.confirmed_booking_count, 0) AS "Confirmed booking count", coalesce(dbs.denied_booking_count, 0) AS "Denied booking count", round(case WHEN (bds.total_bookings = 0) THEN 0 ELSE ((coalesce(cbs.confirmed_booking_count, 0)*1.0)/bds.total_bookings) END, 2) AS "Booking confirmation rate", round(case WHEN (bds.total_bookings = 0) THEN 0 ELSE ((coalesce(dbs.denied_booking_count, 0)*1.0)/bds.total_bookings) END, 2) AS "Denied demand rate", case WHEN (bds.total_bookings = 0) THEN 'NO_BOOKING_ACTIVITY' WHEN (((coalesce(dbs.denied_booking_count, 0)*1.0)/bds.total_bookings) >= 0.20) THEN 'HIGH_DENIED_DEMAND' WHEN (((coalesce(dbs.denied_booking_count, 0)*1.0)/bds.total_bookings) >= 0.10) THEN 'MODERATE_DENIED_DEMAND' WHEN (bds.total_bookings >= 2700) THEN 'HIGH_BOOKING_DEMAND' WHEN (bds.total_bookings >= 2500) THEN 'NORMAL_BOOKING_DEMAND' ELSE 'LOW_BOOKING_DEMAND' END AS "Demand status" FROM (iv_dp_booking_detail_summary AS bds LEFT OUTER JOIN iv_dp_confirmed_booking_summary AS cbs ON bds.resort_name = cbs.resort_title ) LEFT OUTER JOIN iv_dp_denied_booking_summary AS dbs ON bds.resort_name = dbs.resort_name ;

ALTER VIEW dp_booking_demand
 LAYOUT (iv_dp_booking_detail_summary = [0, 0, 200, 200], iv_dp_confirmed_booking_summary = [0, 200, 200, 200], iv_dp_denied_booking_summary = [0, 400, 200, 200]);

