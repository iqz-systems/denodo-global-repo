# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_item_requisition
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_resort360db
    CATALOGNAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_item_requisition.CATALOGNAME}' 
    SCHEMANAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_item_requisition.SCHEMANAME}' 
    RELATIONNAME='Item_Requisition' 
    OUTPUTSCHEMA (
        ir_id = 'Ir_Id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint identity')  NOT NULL SORTABLE IS_AUTOINCREMENT,
        resort_id = 'Resort_Id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        ir_no = 'Ir_No' :'java.lang.String' (OPT) (sourcetypesize='20', sourcetypeid='12', sourcetypename='varchar')  NOT NULL SORTABLE,
        request_date = 'Request_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  NOT NULL SORTABLE,
        ir_status = 'Ir_Status' :'java.lang.String' (OPT) (sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  NOT NULL SORTABLE,
        priority = 'Priority' :'java.lang.Boolean' (OPT) (sourcetypesize='1', sourcetypeid='-7', sourcetypename='bit')  NOT NULL SORTABLE,
        supplier_id = 'Supplier_Id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        quotation_no = 'Quotation_No' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        quote_ref = 'Quote_Ref' :'java.lang.String' (OPT) (sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  NOT NULL SORTABLE,
        ir_sub_total = 'Ir_Sub_Total' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        discount = 'Discount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        shipping_charge = 'Shipping_Charge' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        ir_total = 'Ir_Total' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        shipping_address = 'Shipping_Address' :'java.lang.String' (OPT) (sourcetypesize='50', sourcetypeid='12', sourcetypename='varchar')  NOT NULL SORTABLE,
        createddate = 'CreatedDate' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='3', sourcetypesize='23', sourcetypeid='93', sourcetypename='datetime')  NOT NULL SORTABLE
    )
    CONSTRAINT 'PK__Item_Req__82DB09F5C528A77E' PRIMARY KEY ( 'Ir_Id' )
    INDEX 'PK__Item_Req__82DB09F5C528A77E' CLUSTER UNIQUE PRIMARY ( 'Ir_Id' );

CREATE OR REPLACE TABLE bv_item_requisition I18N us_est (
        ir_id:long (notnull, autoincrement, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Uniquely identifies each item requisition record.') TAGS (inventory),
        resort_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents the unique identifier of the resort associated with the item requisition.') TAGS (resort),
        ir_no:text (notnull, sourcetypeid = '12', sourcetypesize = '20', description = 'Denotes the item requisition number, which serves as an identifier for tracking requisitions.') TAGS (inventory),
        request_date:localdate (notnull, sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which the item requisition request was created.') TAGS (requisition_date),
        ir_status:text (notnull, sourcetypeid = '12', sourcetypesize = '50', description = 'Indicates the current status of the item requisition, such as pending, approved, or completed.'),
        priority:boolean (notnull, sourcetypeid = '-7', sourcetypesize = '1', description = 'Defines whether the item requisition is designated as a high-priority request.'),
        supplier_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents the unique identifier of the supplier associated with the requisition.') TAGS (supplier),
        quotation_no:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        quote_ref:text (notnull, sourcetypeid = '12', sourcetypesize = '50', description = 'Contains the reference number associated with the quotation for the requisition.'),
        ir_sub_total:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Represents the subtotal value of the item requisition before applying discounts, shipping charges, or taxes.') TAGS (requisition_amount),
        discount:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Specifies the discount amount applied to the item requisition.') TAGS (sales),
        shipping_charge:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Denotes the shipping fee incurred for the item requisition.') TAGS (inventory),
        ir_total:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Indicates the total amount of the item requisition after applying all adjustments, including discounts and shipping charges.') TAGS (requisition_amount),
        shipping_address:text (notnull, sourcetypeid = '12', sourcetypesize = '50', description = 'Specifies the delivery address for the item requisition.') TAGS (address),
        createddate:timestamp (notnull, sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Records the exact timestamp when the item requisition was created.') TAGS (inventory)
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_item_requisition view represents a database table designed to store and manage detailed information about item requisition processes in a resort management system. Each record is uniquely identified by the ir_id field, which serves as the primary key. The table captures essential information such as resort_id to associate requisitions with specific resorts and ir_no for tracking requisition numbers. It provides fields like request_date and ir_status to track when requisitions are created and their current status, respectively. The priority field identifies high-priority requisitions, while supplier_id links requisitions to their respective suppliers.

Financial information is thoroughly represented with fields like ir_sub_total, discount, shipping_charge, and ir_total, enabling detailed tracking of costs and adjustments. Quotations are supported through fields such as quotation_no and quote_ref. The view also includes shipping_address to specify delivery locations and createddate to record the exact timestamp of creation.

This view is associated with other tables for enhanced functionality: bv_resorts connects requisitions to resort data, and bv_item_requisition_details links requisitions to their detailed item information. This makes bv_item_requisition a vital component for managing requisitions efficiently in a resort setting, allowing users to track statuses, monitor financial details, and streamline logistical operations.'
    CONSTRAINT 'PK__Item_Req__82DB09F5C528A77E' PRIMARY KEY ( 'ir_id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_item_requisition(
        I18N us_est
        CONSTRAINTS (
             ADD ir_id (any) OPT ANY
             ADD resort_id (any) OPT ANY
             ADD ir_no (any) OPT ANY
             ADD request_date (any) OPT ANY
             ADD ir_status (any) OPT ANY
             ADD priority (any) OPT ANY
             ADD supplier_id (any) OPT ANY
             ADD quotation_no (any) OPT ANY
             ADD quote_ref (any) OPT ANY
             ADD ir_sub_total (any) OPT ANY
             ADD discount (any) OPT ANY
             ADD shipping_charge (any) OPT ANY
             ADD ir_total (any) OPT ANY
             ADD shipping_address (any) OPT ANY
             ADD createddate (any) OPT ANY
        )
        OUTPUTLIST (createddate, discount, ir_id, ir_no, ir_status, ir_sub_total, ir_total, priority, quotation_no, quote_ref, request_date, resort_id, shipping_address, shipping_charge, supplier_id
        )
        WRAPPER (jdbc bv_item_requisition)
    );

