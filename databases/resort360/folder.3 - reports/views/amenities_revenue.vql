CREATE OR REPLACE VIEW amenities_revenue FOLDER = '/3 - reports' DESCRIPTION = 'The amenities_revenue view contains information about amenities offered and their corresponding revenue. It includes fields such as amenity_name, which represents the name of the amenity; amenity_revenue, which indicates the revenue generated from each amenity; and creation_timestamp, which tracks when the record was created. This view could be used to analyze the financial performance of various amenities, understand their contribution to overall revenue, and track the timing of transactions or activities related to these amenities.' 
    TAGS (amenities, sales) (
    amenity_name (description = 'Represents the name of the amenity offered, capturing diverse experiences and services. It includes values like "Zipline Waterfall T...", "Zipline Adventure", "Zipline Waterfall T...", and "Zipline Adventure".') TAGS (amenities),
    amenity_revenue (description = 'Indicates the revenue generated from each amenity, providing insights into their financial contributions.') TAGS (sales),
    creation_timestamp (description = 'Represents the timestamp when the record was created, helping to track the timing of transactions or activities.')
 )
 AS SELECT amenities_name AS amenity_name, sum(cost) AS amenity_revenue, createddate AS creation_timestamp FROM iv_amenities_booking_details GROUP BY amenities_name, createddate;

ALTER VIEW amenities_revenue
 LAYOUT (iv_amenities_booking_details = [20, 20, 200, 200]);

