CREATE OR REPLACE VIEW resort_monthly_net_profit FOLDER = '/3 - reports/sap' DESCRIPTION = 'The resort_monthly_net_profit view contains data related to resorts and their monthly financial performance. It includes fields such as the resort identifier (resort_id), the name of the resort (resort_name), the year and month of booking activity (booking_year and booking_month), the net profit achieved (net_profit), and the profit percentage (profit_percentage). These fields provide valuable insights into the financial standings and trends of resorts over time. This view could be used for analyzing the financial performance of resorts on a monthly basis. It can help identify seasonal trends, track profitability, and support strategic decisions such as pricing adjustments, marketing campaigns, or operational optimizations based on performance metrics.'  (
    resort_id (description = 'Denotes the identifier of the resort, serving as a reference for distinguishing between different resorts.') TAGS (resort),
    resort_name (description = 'Represents the name of the resort, offering clarity and identity for each accommodation.') TAGS (resort),
    booking_year (description = 'Indicates the year in which bookings are recorded, enabling chronological tracking of resort performance.') TAGS (booking_date),
    booking_month (description = 'Specifies the month when bookings are registered, facilitating detailed analysis of seasonal trends.') TAGS (booking_date),
    net_profit (description = 'Represents the financial gain or loss for the resort after accounting for expenses within a specific period.') TAGS (sales),
    profit_percentage TAGS (sales)
 )
 AS SELECT iv_resort_monthly_net_profit.resort_id AS resort_id, iv_resort_monthly_net_profit.resort_name AS resort_name, iv_resort_monthly_net_profit.booking_year AS booking_year, iv_resort_monthly_net_profit.booking_month AS booking_month, iv_resort_monthly_net_profit.net_profit AS net_profit, iv_resort_monthly_net_profit.profit_percentage AS profit_percentage FROM iv_resort_monthly_net_profit;

ALTER VIEW resort_monthly_net_profit
 LAYOUT (iv_resort_monthly_net_profit = [20, 20, 200, 200]);

