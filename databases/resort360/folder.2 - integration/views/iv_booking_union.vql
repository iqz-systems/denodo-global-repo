CREATE OR REPLACE VIEW iv_booking_union FOLDER = '/2 - integration' DESCRIPTION = 'The iv_booking_union view provides a detailed and structured representation of booking-related data in the system. It includes key information such as booking ID, resort ID, booking date, type of booking, and identifiers for tour operators, contracts, and customers. Reservation details are meticulously captured, including arrival and departure dates and times, the number of people involved in the booking, the reservation''s duration, and check-in and check-out status. Financial parameters such as room fare, pre-discount amount, discount percentage, and final payment amount are specified. Additionally, timestamps marking the creation of booking records and identifiers for related customer enquiries enrich the dataset.  

This view is essential for managing, analyzing, and reporting booking records, making it a valuable tool in a resort or hospitality system. It facilitates tracking customer reservations, monitoring financial metrics, and understanding booking trends over time. Operationally, the iv_booking_union view can support room assignments, invoice generation, and the identification of customer preferences, thereby enhancing overall efficiency and decision-making within the organization.'  AS SELECT booking_id AS booking_id, resort_id AS resort_id, booking_date AS booking_date, booking_type_id AS booking_type_id, tour_operator_id AS tour_operator_id, tour_operator_contract_id AS tour_operator_contract_id, customer_id AS customer_id, arrival_date AS arrival_date, arrival_time AS arrival_time, no_of_pax AS no_of_pax, reservation_start_date AS reservation_start_date, reservation_end_date AS reservation_end_date, no_of_days AS no_of_days, is_checked_in AS is_checked_in, room_master_id AS room_master_id, room_fare AS room_fare, amount_before_discount AS amount_before_discount, percentagediscount AS percentagediscount, final_amount AS final_amount, departure_date AS departure_date, departure_time AS departure_time, is_checked_out AS is_checked_out, customer_enquiry_id AS customer_enquiry_id, createddate AS createddate FROM (SELECT booking_id, resort_id, booking_date, booking_type_id, tour_operator_id, tour_operator_contract_id, customer_id, arrival_date, arrival_time, no_of_pax, reservation_start_date, reservation_end_date, no_of_days, is_checked_in, room_master_id, room_fare, amount_before_discount, percentagediscount, final_amount, departure_date, departure_time, is_checked_out, customer_enquiry_id, createddate FROM iv_booking_history SQL UNION ALL SELECT booking_id, resort_id, booking_date, booking_type_id, tour_operator_id, tour_operator_contract_id, customer_id, arrival_date, arrival_time, no_of_pax, reservation_start_date, reservation_end_date, no_of_days, is_checked_in, room_master_id, room_fare, amount_before_discount, percentagediscount, final_amount, departure_date, departure_time, is_checked_out, customer_enquiry_id, createddate FROM iv_booking_current);

ALTER VIEW iv_booking_union
 LAYOUT (iv_booking_history = [20, 20, 200, 200], iv_booking_current = [325, 24, 200, 200]);

