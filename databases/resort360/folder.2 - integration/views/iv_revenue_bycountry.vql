CREATE OR REPLACE VIEW iv_revenue_bycountry FOLDER = '/2 - integration' DESCRIPTION = 'The iv_revenue_bycountry view provides information about the revenue generated from customer bookings, segmented by the nationality of the customer. It includes the fields: customer_nationality, which represents the cultural background of the customer; total_bookings, which indicates the total number of bookings made by customers; and revenue, which represents the monetary value generated from those bookings. The data is structured to offer insights into customer engagement and financial performance across different nationalities. This view could be used for analyzing revenue trends and customer engagement across various nationalities. It might help businesses understand which customer groups contribute the most to bookings and revenue, enabling more targeted marketing strategies, improved financial reporting, and operational decisions.'  (
    customer_nationality (description = 'Represents the nationality of the customer, reflecting their cultural background. It includes values like "Scottish", "Scottish", "Scottish", and "Scottish".') TAGS (nationality),
    total_bookings (description = 'Indicates the total number of bookings made by customers, serving as a measure of their engagement or demand activity.'),
    revenue (description = 'Represents the monetary value generated from customer bookings, providing insights into financial performance.') TAGS (sales)
 )
 AS SELECT customer_nationality AS customer_nationality, count(*) AS total_bookings, sum(final_amount) AS revenue FROM iv_customer_resort_bookings_details GROUP BY customer_nationality, createddate, createddate;

ALTER VIEW iv_revenue_bycountry
 LAYOUT (iv_customer_resort_bookings_details = [141, 93, 200, 200]);

