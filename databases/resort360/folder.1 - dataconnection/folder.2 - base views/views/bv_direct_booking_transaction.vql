# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_direct_booking_transaction
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_resort360db
    CATALOGNAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_direct_booking_transaction.CATALOGNAME}' 
    SCHEMANAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_direct_booking_transaction.SCHEMANAME}' 
    RELATIONNAME='Direct_Booking_Transaction' 
    OUTPUTSCHEMA (
        direct_booking_transaction_id = 'Direct_Booking_Transaction_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        resort_id = 'Resort_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        booking_id = 'Booking_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        transaction_date = 'Transaction_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  SORTABLE,
        transaction_time = 'Transaction_Time' :'java.time.LocalTime' (OPT) (sourcetypedecimals='7', sourcetypesize='16', sourcetypeid='92', sourcetypename='time')  SORTABLE,
        total_amount = 'Total_Amount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT SORTABLE,
        paid = 'Paid' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT SORTABLE,
        balance = 'Balance' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT SORTABLE,
        createddate = 'CreatedDate' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='3', sourcetypesize='23', sourcetypeid='93', sourcetypename='datetime')  NOT NULL SORTABLE
    )
    CONSTRAINT 'PK__Direct_B__7906143B9F1B10E7' PRIMARY KEY ( 'Direct_Booking_Transaction_ID' )
    INDEX 'PK__Direct_B__7906143B9F1B10E7' CLUSTER UNIQUE PRIMARY ( 'Direct_Booking_Transaction_ID' );

CREATE OR REPLACE TABLE bv_direct_booking_transaction I18N us_est (
        direct_booking_transaction_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents a unique identifier for each direct booking transaction in the system.'),
        resort_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Specifies the unique identifier for the resort associated with the booking transaction.'),
        booking_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Denotes the unique identifier assigned to the booking associated with the transaction.'),
        transaction_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the date on which the booking transaction occurred.'),
        transaction_time:time (sourcetypeid = '92', sourcetypedecimals = '7', sourcetypesize = '16', description = 'Captures the specific time at which the transaction was processed.'),
        total_amount:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Represents the total monetary value of the booking transaction.'),
        paid:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Reflects the portion of the total amount that has been paid for the transaction.'),
        balance:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Indicates any remaining amount that has yet to be paid for the transaction.'),
        createddate:timestamp (notnull, sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Specifies the date and time when the booking transaction record was created in the system.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_direct_booking_transaction view represents detailed data related to direct booking transactions within a system. It contains fields such as a unique transaction identifier, resort identifier, booking ID, transaction date and time, total amount of the transaction, paid amount, balance due, and the timestamp when the record was created. These fields provide comprehensive information about each direct booking transaction, including monetary details and associated transactional metadata. This view could be used for managing and analyzing direct booking transactions, tracking payment statuses, monitoring financial data, and generating reports related to resorts and bookings. It can help ensure accurate record-keeping and facilitate operations like auditing, reconciliation, and customer service inquiries.'
    PRIMARY KEY ( 'direct_booking_transaction_id' )
    TAGS (booking, sales)
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_direct_booking_transaction(
        I18N us_est
        CONSTRAINTS (
             ADD direct_booking_transaction_id (any) OPT ANY
             ADD resort_id (any) OPT ANY
             ADD booking_id (any) OPT ANY
             ADD transaction_date (any) OPT ANY
             ADD transaction_time (any) OPT ANY
             ADD total_amount (any) OPT ANY
             ADD paid (any) OPT ANY
             ADD balance (any) OPT ANY
             ADD createddate (any) OPT ANY
        )
        OUTPUTLIST (balance, booking_id, createddate, direct_booking_transaction_id, paid, resort_id, total_amount, transaction_date, transaction_time
        )
        WRAPPER (jdbc bv_direct_booking_transaction)
    );

