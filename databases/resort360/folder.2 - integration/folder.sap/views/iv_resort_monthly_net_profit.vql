CREATE OR REPLACE VIEW iv_resort_monthly_net_profit FOLDER = '/2 - integration/sap' DESCRIPTION = 'The iv_resort_monthly_net_profit view provides a structured overview of the monthly net profits of various resorts, featuring information such as resort identifiers (`resort_id`), resort names (`resort_name`), booking year (`booking_year`), booking month (`booking_month`), net profit (`net_profit`), and profit percentage (`profit_percentage`). These data elements enable detailed analysis of financial performance over time, helping to identify trends, patterns, or anomalies. This view could be used to track and analyze resorts'' monthly financial performance, identify profitable time periods, make comparisons among resorts based on profitability metrics, and support data-driven decisions in areas like resort management and marketing strategy development.'  (
    resort_id TAGS (resort),
    resort_name TAGS (resort),
    booking_year TAGS (booking_date),
    booking_month TAGS (booking_date)
 )
 AS SELECT iv_customer_resort_bookings_details.resort_id AS resort_id, iv_customer_resort_bookings_details.resort_name AS resort_name, getyear(iv_customer_resort_bookings_details.booking_date) AS booking_year, getmonth(iv_customer_resort_bookings_details.booking_date) AS booking_month, (sum(iv_customer_resort_bookings_details.final_amount)-sum(iv_item_requisition_sap.irtotal)) AS net_profit, round(case WHEN (sum(iv_customer_resort_bookings_details.final_amount) > 0) THEN (((sum(iv_customer_resort_bookings_details.final_amount)-sum(iv_item_requisition_sap.irtotal))/sum(iv_customer_resort_bookings_details.final_amount))*100) ELSE 0 END, 2) AS profit_percentage FROM iv_customer_resort_bookings_details AS iv_customer_resort_bookings_details LEFT OUTER JOIN iv_item_requisition_sap AS iv_item_requisition_sap ON iv_customer_resort_bookings_details.resort_id = iv_item_requisition_sap.resort_id  GROUP BY iv_customer_resort_bookings_details.resort_name, iv_customer_resort_bookings_details.resort_id, getyear(iv_customer_resort_bookings_details.booking_date), getmonth(iv_customer_resort_bookings_details.booking_date) ORDER BY booking_year ASC, booking_month ASC, net_profit DESC;

ALTER VIEW iv_resort_monthly_net_profit
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200], iv_item_requisition_sap = [306, 22, 200, 200]);

