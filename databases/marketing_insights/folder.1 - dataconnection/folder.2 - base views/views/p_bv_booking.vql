CREATE OR REPLACE VIEW p_bv_booking FOLDER = '/1 - dataconnection/2 - base views' DESCRIPTION = 'Integration view providing standardized booking information.'  (
    "Booking_ID" (description = 'booking id')
 )
 AS SELECT bv_booking."Booking_ID" AS "Booking_ID", bv_booking."Resort_ID" AS "Resort_ID", bv_booking."Booking_Date" AS "Booking_Date", bv_booking."Booking_Type_ID" AS "Booking_Type_ID", bv_booking."Tour_Operator_ID" AS "Tour_Operator_ID", bv_booking."Tour_Operator_Contract_ID" AS "Tour_Operator_Contract_ID", bv_booking."Customer_ID" AS "Customer_ID", bv_booking."Arrival_Date" AS "Arrival_Date", bv_booking."Arrival_Time" AS "Arrival_Time", bv_booking."No_of_Pax" AS "No_of_Pax", bv_booking."Reservation_Start_Date" AS "Reservation_Start_Date", bv_booking."Reservation_End_Date" AS "Reservation_End_Date", bv_booking."No_Of_Days" AS "No_Of_Days", bv_booking."Is_Checked_in" AS "Is_Checked_in", bv_booking."Room_Master_ID" AS "Room_Master_ID", bv_booking."Room_Fare" AS "Room_Fare", bv_booking."Amount_Before_Discount" AS "Amount_Before_Discount", bv_booking."PercentageDiscount" AS "PercentageDiscount", bv_booking."Final_Amount" AS "Final_Amount", bv_booking."Departure_Date" AS "Departure_Date", bv_booking."Departure_Time" AS "Departure_Time", bv_booking."Is_Checked_Out" AS "Is_Checked_Out", bv_booking."Customer_Enquiry_Id" AS "Customer_Enquiry_Id", bv_booking."Booking_Status" AS "Booking_Status", bv_booking."CreatedDate" AS "CreatedDate", bv_booking."ModifiedDate" AS "ModifiedDate", bv_booking."ModifiedBy" AS "ModifiedBy", bv_booking."Currency_ID" AS "Currency_ID", bv_booking."Tax_Amount" AS "Tax_Amount", bv_booking."Special_Requests" AS "Special_Requests", bv_booking."Cancellation_Reason" AS "Cancellation_Reason", bv_booking."Cancelled_By" AS "Cancelled_By", bv_booking."Cancelled_Date" AS "Cancelled_Date" FROM bv_booking;

ALTER VIEW p_bv_booking
 LAYOUT (bv_booking = [20, 20, 200, 200]);

