    INDEX 'PK__Booking__35ABFDE0CE9CFA39' CLUSTER UNIQUE PRIMARY ( 'Booking_ID' );

CREATE OR REPLACE TABLE bv_booking I18N us_est (
        booking_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents a unique identifier for each booking record in the system.') TAGS (booking),
        resort_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Denotes the identifier of the resort associated with the booking.') TAGS (resort),
        booking_date:timestamp (sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Indicates the date and time when the booking was created.') TAGS (booking_date),
        booking_type_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the type or category of the booking.'),
        tour_operator_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Specifies the unique identifier of the tour operator associated with the booking.'),
        tour_operator_contract_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Captures the identifier of the contract between the tour operator and the resort for the booking.'),
        customer_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Identifies the customer who made the booking.') TAGS (customer),
        arrival_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which the customer is expected to arrive at the resort.') TAGS (check_in_list),
        arrival_time:time (sourcetypeid = '92', sourcetypedecimals = '7', sourcetypesize = '16', description = 'Indicates the time when the customer is expected to arrive at the resort.'),
        no_of_pax:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents the number of people included in the booking.'),
        reservation_start_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the start date of the reservation period for the booking.'),
        reservation_end_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the end date of the reservation period for the booking.'),
        no_of_days:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Specifies the total number of days for which the reservation is made.'),
        is_checked_in:boolean (sourcetypeid = '-7', sourcetypesize = '1', description = 'Indicates whether the customer has checked into the resort.'),
        room_master_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the identifier of the room assigned for the booking.'),
        room_fare:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Represents the cost of the room per booking.'),
        amount_before_discount:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Captures the total amount for the booking before any discounts are applied.') TAGS (sales),
        percentagediscount:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Specifies the discount percentage applied to the booking.'),
        final_amount:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Indicates the total amount to be paid after applying discounts.') TAGS (sales),
        departure_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which the customer is expected to check out from the resort.'),
        departure_time:time (sourcetypeid = '92', sourcetypedecimals = '7', sourcetypesize = '16', description = 'Specifies the time when the customer is expected to check out from the resort.'),
        is_checked_out:text (sourcetypeid = '12', sourcetypesize = '50', description = 'Indicates whether the customer has checked out of the resort. It includes values like "1", "1", "1", and "1".'),
        customer_enquiry_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the identifier of the customer enquiry related to the booking.'),
        createddate:timestamp (sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Represents the timestamp when the booking record was created in the system.')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    DESCRIPTION = 'The bv_booking view provides detailed information regarding resort bookings in a structured format. It includes fields such as booking identifiers, resort details, customer information, reservation periods, arrival and departure schedules, room assignments, financial amounts like discounts and final charges, and status indicators like check-in and check-out statuses. Furthermore, it has associations with related datasets, including booking types, resorts, and room details, which enhance the opportunities for data analysis and integration.

This view can be used to manage resort bookings efficiently, track customer arrivals and departures, calculate financial details including discounts, and analyze trends across booking records. Additionally, it supports integrations with related datasets, allowing for a comprehensive understanding of resort operations and customer behaviors.'
    PRIMARY KEY ( 'booking_id' , 'resort_id' )
    TAGS (booking, booking_date, check_in_list, customer, reservation_details, resort, sales)
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_booking(
        I18N us_est
        CONSTRAINTS (
             ADD booking_id (any) OPT ANY
             ADD resort_id (any) OPT ANY
             ADD booking_date (any) OPT ANY
             ADD booking_type_id (any) OPT ANY
             ADD tour_operator_id (any) OPT ANY
             ADD tour_operator_contract_id (any) OPT ANY
             ADD customer_id (any) OPT ANY
             ADD arrival_date (any) OPT ANY
             ADD arrival_time (any) OPT ANY
             ADD no_of_pax (any) OPT ANY
             ADD reservation_start_date (any) OPT ANY
             ADD reservation_end_date (any) OPT ANY
             ADD no_of_days (any) OPT ANY
             ADD is_checked_in (any) OPT ANY
             ADD room_master_id (any) OPT ANY
             ADD room_fare (any) OPT ANY
             ADD amount_before_discount (any) OPT ANY
             ADD percentagediscount (any) OPT ANY
             ADD final_amount (any) OPT ANY
             ADD departure_date (any) OPT ANY
             ADD departure_time (any) OPT ANY
             ADD is_checked_out (any) OPT ANY
             ADD customer_enquiry_id (any) OPT ANY
             ADD createddate (any) OPT ANY
        )
        OUTPUTLIST (amount_before_discount, arrival_date, arrival_time, booking_date, booking_id, booking_type_id, createddate, customer_enquiry_id, customer_id, departure_date, departure_time, final_amount, is_checked_in, is_checked_out, no_of_days, no_of_pax, percentagediscount, reservation_end_date, reservation_start_date, resort_id, room_fare, room_master_id, tour_operator_contract_id, tour_operator_id
        )
        WRAPPER (jdbc bv_booking)
    );

