# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC summ_room_category_revenue
    FOLDER = '/6 - summaries'
    DATASOURCENAME=ds_sql_resort360db
    CATALOGNAME='${databases.resort360.folder.6 - summaries.views.jdbc.summ_room_category_revenue.CATALOGNAME}' ESCAPE
    SCHEMANAME='${databases.resort360.folder.6 - summaries.views.jdbc.summ_room_category_revenue.SCHEMANAME}' ESCAPE
    RELATIONNAME='summ_room_category_revenue' 
    OUTPUTSCHEMA (
        resort_identifier = 'resort_identifier' :'java.lang.Long' (OPT) (sourcetypeid='-5', sourcetypename='BIGINT')  SORTABLE NOT UPDATEABLE,
        resort_title = 'resort_title' :'java.lang.String' (OPT) (sourcetypesize='100', sourcetypeid='-9', sourcetypename='NVARCHAR')  SORTABLE NOT UPDATEABLE,
        room_category = 'room_category' :'java.lang.String' (OPT) (sourcetypesize='100', sourcetypeid='12', sourcetypename='VARCHAR')  SORTABLE NOT UPDATEABLE,
        booking_revenue = 'booking_revenue' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='20', sourcetypesize='38', sourcetypeid='2', sourcetypename='NUMERIC')  SORTABLE NOT UPDATEABLE
    );

CREATE OR REPLACE SUMMARY VIEW summ_room_category_revenue (
        resort_identifier:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        resort_title:text (sourcetypeid = '-9', sourcetypesize = '100'),
        room_category:text (sourcetypeid = '12', sourcetypesize = '100'),
        booking_revenue:decimal
    )
    FOLDER = '/6 - summaries'
    DESCRIPTION = 'The summ_room_category_revenue view contains information about room categories in resorts and the revenue generated from bookings. It includes details such as the identifier of the resort, the title of the resort, the category of rooms, and the booking revenue associated with each category. This view provides structured data on resort and room categories as well as the financial performance of bookings.'
    ADD SEARCHMETHOD summ_room_category_revenue(
        I18N us_est
        CONSTRAINTS (
             ADD resort_identifier (any) OPT ANY
             ADD resort_title (any) OPT ANY
             ADD room_category (any) OPT ANY
             ADD booking_revenue (any) OPT ANY
        )
        OUTPUTLIST (booking_revenue, resort_identifier, resort_title, room_category
        )
        WRAPPER (jdbc summ_room_category_revenue)
    )
AS SELECT room_category_revenue.resort_identifier AS resort_identifier, room_category_revenue.resort_title AS resort_title, room_category_revenue.room_category AS room_category, room_category_revenue.booking_revenue AS booking_revenue FROM (SELECT resort_identifier, resort_title, room_category, booking_revenue FROM room_category_revenue);

